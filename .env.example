# Public read-only base URL for book_core (no secrets).
#
# Leave unset to use bundled fixtures (offline).
# Use an absolute URL for a remote API, e.g.:
#   VITE_BOOK_CORE_API_BASE=http://YOUR_ORACLE_HOST:8002
# Use same-origin when the SPA is served behind a proxy that forwards /api:
#   VITE_BOOK_CORE_API_BASE=same-origin
#
# Note: GitHub Pages is HTTPS. A plain-HTTP book_core URL will be blocked by
# mixed-content rules in the browser — use the Oracle same-origin deploy, or
# put book_core behind a real HTTPS cert (needs a domain).
VITE_BOOK_CORE_API_BASE=
